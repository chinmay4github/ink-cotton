    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@nestjs/core": "^10",
    "@nestjs/event-emitter": "^2",
    "@nestjs/jwt": "^10",
    "@nestjs/passport": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/swagger": "^7",
    "@nestjs/terminus": "^10",
    "@nestjs/throttler": "^5",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "compression": "^1.7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16",
    "helmet": "^7",
    "passport": "^0.7",
    "passport-jwt": "^4",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
