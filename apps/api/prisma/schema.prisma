  packed_at                DateTime?                  @db.Timestamptz(6)
  delivery_agent           delivery_agents?           @relation("shipments_delivery_agent_id", fields: [delivery_agent_id], references: [id])
  order                    orders                     @relation("shipments_order_id", fields: [order_id], references: [id], onDelete: Cascade)
  vendor                   vendors                    @relation("shipments_vendor_id", fields: [vendor_id], references: [id])
  delivery_agent_locations delivery_agent_locations[] @relation("delivery_agent_locations_shipment_id")
  return_requests          return_requests[]          @relation("return_requests_reverse_shipment_id")
  shipment_items           shipment_items[]           @relation("shipment_items_shipment_id")
  shipment_tracking_events shipment_tracking_events[] @relation("shipment_tracking_events_shipment_id")
  @@schema("shop")
}

model sizes {
  id               Int                @id @default(autoincrement()) @db.SmallInt
  size_group       size_group
  code             String             @db.VarChar(20)
  label            String             @db.VarChar(50)
  sort_order       Int                @default(0)
  product_variants product_variants[] @relation("product_variants_size_id")
  @@unique([size_group, code], map: "sizes_size_group_code_key")
  @@schema("shop")
}

model users {
  id                       BigInt                     @id @default(autoincrement())
  role                     user_role                  @default(customer)
  full_name                String                     @db.VarChar(120)
  email                    String?                    @unique @db.Citext
  phone                    String?                    @unique @db.VarChar(20)
  password_hash            String
  avatar_url               String?
  status                   account_status             @default(active)
  email_verified           Boolean                    @default(false)
  phone_verified           Boolean                    @default(false)
  last_login_at            DateTime?                  @db.Timestamptz(6)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  addresses                addresses[]                @relation("addresses_user_id")
  admin_audit_log          admin_audit_log[]          @relation("admin_audit_log_admin_id")
  admin_profile            admin_profiles?            @relation("admin_profiles_user_id")
  cart                     carts?                     @relation("carts_user_id")
  coupons                  coupons[]                  @relation("coupons_created_by")
  delivery_agent           delivery_agents?           @relation("delivery_agents_user_id")
  device_tokens            device_tokens[]            @relation("device_tokens_user_id")
  inventory_movements      inventory_movements[]      @relation("inventory_movements_created_by")
  notification_preferences notification_preferences[] @relation("notification_preferences_user_id")
  notifications            notifications[]            @relation("notifications_user_id")
  order_status_history     order_status_history[]     @relation("order_status_history_changed_by")
  orders                   orders[]                   @relation("orders_user_id")
  product_reviews          product_reviews[]          @relation("product_reviews_user_id")
  products                 products[]                 @relation("products_approved_by")
  return_requests          return_requests[]          @relation("return_requests_user_id")
  shipment_tracking_events shipment_tracking_events[] @relation("shipment_tracking_events_updated_by")
  vendors_by_approved_by   vendors[]                  @relation("vendors_approved_by")
  vendor                   vendors?                   @relation("vendors_user_id")
  wishlist_items           wishlist_items[]           @relation("wishlist_items_user_id")
  @@schema("shop")
}

model vendor_bank_accounts {
  id                 BigInt   @id @default(autoincrement())
  vendor_id          BigInt
  account_holder     String   @db.VarChar(150)
  account_number_enc String
  ifsc               String   @db.VarChar(11)
  bank_name          String?  @db.VarChar(100)
  is_primary         Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  vendor             vendors  @relation("vendor_bank_accounts_vendor_id", fields: [vendor_id], references: [id], onDelete: Cascade)
  @@schema("shop")
}

model vendor_payouts {
  id           BigInt    @id @default(autoincrement())
  vendor_id    BigInt
  period_start DateTime  @db.Date
  period_end   DateTime  @db.Date
  gross_amount Decimal   @db.Decimal(12, 2)
  commission   Decimal   @db.Decimal(12, 2)
  net_amount   Decimal   @db.Decimal(12, 2)
  status       String    @default("pending") @db.VarChar(20)
  reference_no String?   @db.VarChar(100)
  paid_at      DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  vendor       vendors   @relation("vendor_payouts_vendor_id", fields: [vendor_id], references: [id])
  @@schema("shop")
}

model vendors {
  id                   BigInt                 @id @default(autoincrement())
  user_id              BigInt                 @unique
  business_name        String                 @db.VarChar(150)
  display_name         String                 @db.VarChar(150)
  slug                 String                 @unique @db.VarChar(160)
  gstin                String?                @unique @db.VarChar(15)
  pan                  String?                @db.VarChar(10)
  support_email        String?                @db.Citext
  support_phone        String?                @db.VarChar(20)
  logo_url             String?
  pickup_address_id    BigInt?
  commission_pct       Decimal                @default(10.00) @db.Decimal(5, 2)
  rating_avg           Decimal                @default(0) @db.Decimal(3, 2)
  status               vendor_status          @default(pending)
  approved_by          BigInt?
  approved_at          DateTime?              @db.Timestamptz(6)
  rejection_reason     String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  approved_by_ref      users?                 @relation("vendors_approved_by", fields: [approved_by], references: [id])
  pickup_address       addresses?             @relation("vendors_pickup_address_id", fields: [pickup_address_id], references: [id])
  user                 users                  @relation("vendors_user_id", fields: [user_id], references: [id], onDelete: Restrict)
  coupons              coupons[]              @relation("coupons_vendor_id")
  order_items          order_items[]          @relation("order_items_vendor_id")
  products             products[]             @relation("products_vendor_id")
  shipments            shipments[]            @relation("shipments_vendor_id")
  vendor_bank_accounts vendor_bank_accounts[] @relation("vendor_bank_accounts_vendor_id")
  vendor_payouts       vendor_payouts[]       @relation("vendor_payouts_vendor_id")
  @@schema("shop")
}

model wishlist_items {
  user_id    BigInt
  product_id BigInt
  added_at   DateTime @default(now()) @db.Timestamptz(6)
  product    products @relation("wishlist_items_product_id", fields: [product_id], references: [id], onDelete: Cascade)
  user       users    @relation("wishlist_items_user_id", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, product_id])
  @@schema("shop")
}

